# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# NewsData.io API Key (get from https://newsdata.io)
NEWS_API_KEY=your_newsdata_io_key_here

# Daily delivery time in 24h format (e.g. 08:00 for 8 AM)
DAILY_NEWS_TIME=08:00

# Default country code (e.g. us, gb, in, ca, au)
DEFAULT_COUNTRY=in

# SQLite database path (Docker uses /app/data/bot_data.db for persistence)
DATABASE_PATH=bot_data.db

# Enable RSS feed fallback (set to 0 to disable)
ENABLE_RSS=1

# NewsData.io API request limit per day (free tier: 200, set to 0 to disable local limiting)
DAILY_REQUEST_LIMIT=200

# Breaking news alert check interval in minutes (set to 0 to disable scheduled alerts)
BREAKING_ALERT_INTERVAL_MINUTES=30

# How long to keep breaking alert records for duplicate suppression (in days)
BREAKING_ALERT_RETENTION_DAYS=14

# Comma-separated keywords for breaking news detection
BREAKING_ALERT_KEYWORDS=breaking,urgent,alert,earthquake,flood,storm,war,attack,explosion,fire,crash,emergency
