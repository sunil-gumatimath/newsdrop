# ── Required ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
NEWS_API_KEY=your_newsdata_io_key_here

# ── Optional — Daily news ─────────────────────────────────────────────
DAILY_NEWS_TIME=08:00
DEFAULT_COUNTRY=us

# ── Optional — Database ───────────────────────────────────────────────
# Docker default: DATABASE_PATH=/app/data/bot_data.db
# Local default:  DATABASE_PATH=bot_data.db
DATABASE_PATH=

# ── Optional — RSS feed fallback ──────────────────────────────────────
# Set to 0 to disable RSS augmentation.
ENABLE_RSS=1

# ── Optional — Reddit cross-confirmation ──────────────────────────────
# Set to 1 to rank stories higher when the same headline appears in RSS/news
# and curated Reddit subreddits. No Reddit API key required.
ENABLE_REDDIT=0

# ── Optional — API request limits ─────────────────────────────────────
# NewsData.io free tier: 200 requests/day. Set to 0 to disable local limiting.
DAILY_REQUEST_LIMIT=200

# ── Optional — Per-user command cooldowns (seconds) ───────────────────
# Prevents accidental spam from burning the daily budget above. Set to 0 to
# disable a cooldown entirely (useful for solo self-hosted deployments).
NEWS_COOLDOWN_SECONDS=0
SEARCH_COOLDOWN_SECONDS=0

# ── Optional — Shared state backend ────────────────────────────────────
# Set REDIS_URL to share cache, rate limits, and API budget across workers.
# When empty, the bot uses an in-memory backend (single-worker only).
# Docker Compose sets this automatically to redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL=

# ── Optional — Redis authentication ────────────────────────────────────
# Password used by the Redis container (via --requirepass). Must match
# REDIS_URL if connecting to a password-protected instance.
REDIS_PASSWORD=change-me-to-a-strong-password

# ── Optional — Logging ────────────────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO (default), WARNING, ERROR
# LOG_FORMAT: text (default) or json for structured production logs
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── Optional — Breaking news alerts ───────────────────────────────────
# How often (in minutes) to check for breaking-news matches. Set to 0 to disable.
BREAKING_ALERT_INTERVAL_MINUTES=30
# How long (in days) to keep sent-alert records for duplicate suppression.
BREAKING_ALERT_RETENTION_DAYS=14
# Comma-separated keywords used to detect breaking stories (word-boundary match).
BREAKING_ALERT_KEYWORDS=breaking,urgent,alert,earthquake,flood,storm,war,attack,explosion,fire,crash,emergency,evacuation,shooting,terror,cyclone,hurricane
